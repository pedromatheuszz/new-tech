---
/** Bloco central usado nas páginas de confirmação e de erro. */
import Icone from './Icone.astro';

interface Props {
  icone: string;
  sobrelinha: string;
  titulo: string;
  tom?: 'sucesso' | 'neutro';
}

const { icone, sobrelinha, titulo, tom = 'neutro' } = Astro.props;
---

<section class="aviso" aria-labelledby="aviso-titulo">
  <div class="aviso__fundo" aria-hidden="true"></div>
  <div class="container aviso__conteudo">
    <span class:list={['aviso__icone', `aviso__icone--${tom}`]}>
      <Icone nome={icone} tamanho={34} />
    </span>
    <p class="sobrelinha">{sobrelinha}</p>
    <h1 id="aviso-titulo">{titulo}</h1>
    <div class="aviso__texto"><slot /></div>
    <div class="aviso__acoes"><slot name="acoes" /></div>
  </div>
</section>

<style>
  .aviso {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: calc(var(--altura-cabecalho) + 48px) 0 80px;
    overflow: clip;
    text-align: center;
  }

  .aviso__fundo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 45% at 50% 40%, rgb(1 55 234 / 0.28), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 64px 64px;
    mask-image: radial-gradient(ellipse 60% 60% at 50% 45%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 45%, #000 30%, transparent 80%);
  }

  .aviso__conteudo {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 18px;
    max-width: 640px;
  }

  .aviso__icone {
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    margin-bottom: 8px;
    border-radius: 50%;
    color: var(--marca-ciano);
    background: rgb(1 138 252 / 0.1);
    box-shadow:
      inset 0 0 0 1px rgb(5 189 253 / 0.3),
      0 0 50px -8px rgb(1 138 252 / 0.6);
  }

  .aviso__icone--sucesso {
    color: var(--sucesso);
    background: rgb(62 224 161 / 0.1);
    box-shadow:
      inset 0 0 0 1px rgb(62 224 161 / 0.35),
      0 0 50px -8px rgb(62 224 161 / 0.45);
  }

  h1 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    letter-spacing: -0.035em;
  }

  .aviso__texto {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--texto-2);
  }

  .aviso__acoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }
</style>
