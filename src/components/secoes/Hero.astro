---
import Icone from '../Icone.astro';
import Logo from '../Logo.astro';

/* Composição decorativa: trecho de "código" que resume o que a New Tech faz. */
const linhasCodigo = [
  '<span class="t-k">import</span> { ideia } <span class="t-k">from</span> <span class="t-s">"./seu-negocio"</span>;',
  '',
  '<span class="t-k">const</span> <span class="t-v">projeto</span> = <span class="t-k">await</span> newTech.<span class="t-f">desenvolver</span>({',
  '  ideia,',
  '  <span class="t-p">plataformas</span>: [<span class="t-s">"web"</span>, <span class="t-s">"mobile"</span>],',
  '  <span class="t-p">foco</span>: <span class="t-s">"experiência do usuário"</span>,',
  '  <span class="t-p">qualidade</span>: <span class="t-b">true</span>,',
  '});',
  '',
  'projeto.<span class="t-f">publicar</span>(); <span class="t-c">// pronto para crescer</span>',
];

const barras = [38, 56, 44, 72, 60, 86, 70];
---

<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="hero__fundo" aria-hidden="true">
    <div class="hero__grade"></div>
    <div class="hero__luz hero__luz--1"></div>
    <div class="hero__luz hero__luz--2"></div>
    <span class="hero__feixe hero__feixe--1"></span>
    <span class="hero__feixe hero__feixe--2"></span>
    <span class="hero__feixe hero__feixe--3"></span>
  </div>

  <div class="container hero__conteudo">
    <div class="hero__texto">
      <p class="selo hero__selo entrada" style="--atraso:0">
        <span class="hero__pulso" aria-hidden="true"></span>
        Tecnologia, inovação e soluções digitais
      </p>

      <h1 id="hero-titulo" class="hero__titulo entrada" style="--atraso:1">
        Transformamos ideias em <span class="texto-gradiente">soluções digitais.</span>
      </h1>

      <p class="hero__subtitulo entrada" style="--atraso:2">
        Desenvolvemos sites, aplicativos e experiências digitais que conectam tecnologia, inovação e estratégia para
        impulsionar negócios.
      </p>

      <div class="hero__acoes entrada" style="--atraso:3">
        <a href="#servicos" class="btn btn-primario btn-lg">
          Conheça nossos serviços
          <Icone nome="arrow-right" tamanho={18} class="icone--seta" />
        </a>
        <a href="#contato" class="btn btn-secundario btn-lg">Solicite um orçamento</a>
      </div>

      <ul class="hero__areas entrada" style="--atraso:4" role="list" aria-label="O que a New Tech faz">
        <li><Icone nome="code-xml" tamanho={18} /> Softwares e aplicativos</li>
        <li><Icone nome="globe" tamanho={18} /> Sites profissionais</li>
        <li><Icone nome="clapperboard" tamanho={18} /> Edição de vídeos</li>
      </ul>
    </div>

    <div class="hero__visual entrada" style="--atraso:2" aria-hidden="true">
      <div class="hv">
        <div class="hv__orbitas">
          <span></span><span></span>
        </div>

        <div class="hv__editor">
          <div class="hv__barra">
            <span class="hv__pontos"><i></i><i></i><i></i></span>
            <span class="hv__aba hv__aba--ativa"><Icone nome="code-xml" tamanho={12} /> projeto.ts</span>
            <span class="hv__aba">app.tsx</span>
          </div>
          <pre class="hv__codigo"><code>{linhasCodigo.map((linha, i) => (
            <span class="hv__linha" style={`--l:${i}`}><span class="hv__num">{i + 1}</span><span class="hv__txt" set:html={linha || ' '} /></span>
          ))}</code></pre>
          <div class="hv__status">
            <span class="hv__status-ok"><i></i> pronto</span>
            <span>TypeScript</span>
            <span>UTF-8</span>
          </div>
        </div>

        <div class="hv__celular">
          <div class="hv__tela">
            <span class="hv__ilha"></span>
            <div class="hv__app-topo">
              <Logo variante="simbolo" altura={14} alt="" prioritario class="hv__app-logo" />
              <span class="hv__app-linha hv__app-linha--curta"></span>
              <span class="hv__app-avatar"></span>
            </div>
            <div class="hv__app-card">
              <span class="hv__app-rotulo">Visão geral</span>
              <div class="hv__barras">
                {barras.map((altura, i) => <span style={`--h:${altura}%;--b:${i}`} />)}
              </div>
            </div>
            <div class="hv__app-lista">
              {[0, 1, 2].map((i) => (
                <div class="hv__app-item" style={`--i:${i}`}>
                  <span class="hv__app-icone" />
                  <span class="hv__app-textos">
                    <span class="hv__app-linha" />
                    <span class="hv__app-linha hv__app-linha--curta" />
                  </span>
                </div>
              ))}
            </div>
            <div class="hv__app-nav">
              <span class="ativo"></span><span></span><span></span><span></span>
            </div>
          </div>
        </div>

        <div class="hv__chip hv__chip--1"><Icone nome="smartphone" tamanho={16} /> Aplicativos</div>
        <div class="hv__chip hv__chip--2"><Icone nome="globe" tamanho={16} /> Sites</div>
        <div class="hv__chip hv__chip--3"><Icone nome="clapperboard" tamanho={16} /> Vídeos</div>
      </div>
    </div>
  </div>

  <a href="#quem-somos" class="hero__rolar" aria-label="Ir para a seção Quem somos">
    <span class="hero__mouse" aria-hidden="true"><span></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: max(640px, 100svh);
    padding: calc(var(--altura-cabecalho) + clamp(40px, 7vw, 72px)) 0 clamp(72px, 9vw, 110px);
    overflow: clip;
    isolation: isolate;
  }

  /* ---------- Fundo ---------- */
  .hero__fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__grade {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000 20%, transparent 75%);
  }

  .hero__luz {
    position: absolute;
    border-radius: 50%;
  }

  .hero__luz--1 {
    top: -24%;
    right: -12%;
    width: min(900px, 110vw);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(1 55 234 / 0.42), rgb(1 55 234 / 0.08) 45%, transparent 68%);
  }

  .hero__luz--2 {
    bottom: -30%;
    left: -18%;
    width: min(760px, 100vw);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(5 189 253 / 0.16), transparent 62%);
  }

  .hero__feixe {
    position: absolute;
    width: 1px;
    height: 180px;
    background: linear-gradient(to bottom, transparent, var(--marca-ciano), transparent);
    opacity: 0;
  }

  .hero__feixe--1 {
    left: calc(50% + 64px * 2);
  }
  .hero__feixe--2 {
    left: calc(50% - 64px * 5);
  }
  .hero__feixe--3 {
    left: calc(50% + 64px * 6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__feixe {
      animation: feixe 7s linear infinite;
    }
    .hero__feixe--2 {
      animation-delay: 2.4s;
      animation-duration: 9s;
    }
    .hero__feixe--3 {
      animation-delay: 4.6s;
      animation-duration: 8s;
    }
  }

  @keyframes feixe {
    0% {
      transform: translateY(-200px);
      opacity: 0;
    }
    10% {
      opacity: 0.9;
    }
    60% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(100vh);
      opacity: 0;
    }
  }

  /* ---------- Conteúdo ---------- */
  .hero__conteudo {
    display: grid;
    gap: clamp(48px, 7vw, 72px);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__conteudo {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    }
  }

  .hero__texto {
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  .hero__selo {
    background: rgb(1 138 252 / 0.08);
    border-color: rgb(5 189 253 / 0.28);
    color: #cfe6ff;
  }

  .hero__pulso {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--marca-ciano);
    box-shadow: 0 0 10px var(--marca-ciano);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__pulso::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--marca-ciano);
      animation: pulso 2.2s var(--ease-saida) infinite;
    }
  }

  @keyframes pulso {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .hero__titulo {
    font-size: clamp(2.5rem, 1.3rem + 4.6vw, 4.6rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .hero__subtitulo {
    max-width: 560px;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.7;
    color: var(--texto-2);
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 8px;
  }

  .hero__areas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 12px;
    padding-top: 22px;
    border-top: 1px solid var(--borda);
    width: 100%;
    max-width: 560px;
  }

  .hero__areas li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    color: var(--texto-2);
  }

  .hero__areas :global(.icone) {
    color: var(--marca-ciano);
  }

  @media (max-width: 479.98px) {
    .hero__acoes .btn {
      width: 100%;
    }
  }

  /* ---------- Composição visual ---------- */
  .hero__visual {
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
    container-type: inline-size;
  }

  .hv {
    position: relative;
    aspect-ratio: 1 / 0.9;
    font-size: 2cqw;
  }

  .hv__orbitas span {
    position: absolute;
    top: 50%;
    left: 52%;
    border-radius: 50%;
    border: 1px dashed rgb(5 189 253 / 0.18);
    translate: -50% -50%;
  }

  .hv__orbitas span:nth-child(1) {
    width: 86cqw;
    aspect-ratio: 1;
  }

  .hv__orbitas span:nth-child(2) {
    width: 118cqw;
    aspect-ratio: 1;
    border-color: rgb(255 255 255 / 0.05);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hv__orbitas span:nth-child(1) {
      animation: girar 60s linear infinite;
    }
  }

  @keyframes girar {
    to {
      rotate: 360deg;
    }
  }

  /* Editor de código */
  .hv__editor {
    position: absolute;
    top: 6%;
    left: 0;
    width: 82%;
    border-radius: 3cqw;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: linear-gradient(180deg, rgb(13 18 30 / 0.92), rgb(7 10 18 / 0.94));
    box-shadow:
      0 0 0 1px rgb(5 189 253 / 0.08),
      0 40px 80px -30px rgb(0 0 0 / 0.85),
      0 30px 90px -40px rgb(1 138 252 / 0.55);
    overflow: hidden;
  }

  .hv__barra {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 2cqw 2.6cqw;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    background: rgb(255 255 255 / 0.02);
  }

  .hv__pontos {
    display: flex;
    gap: 1cqw;
    margin-right: 1.6cqw;
  }

  .hv__pontos i {
    width: 1.8cqw;
    height: 1.8cqw;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }

  .hv__pontos i:first-child {
    background: rgb(5 189 253 / 0.7);
  }

  .hv__aba {
    display: inline-flex;
    align-items: center;
    gap: 0.8cqw;
    padding: 0.8cqw 1.8cqw;
    border-radius: 1.4cqw;
    font-family: var(--fonte-codigo);
    font-size: 0.86em;
    color: var(--texto-3);
  }

  .hv__aba :global(.icone) {
    width: 1.1em;
    height: 1.1em;
  }

  .hv__aba--ativa {
    color: var(--texto);
    background: rgb(255 255 255 / 0.06);
  }

  .hv__aba--ativa :global(.icone) {
    color: var(--marca-ciano);
  }

  .hv__codigo {
    margin: 0;
    padding: 2.8cqw 3cqw 3.2cqw 1.6cqw;
    font-family: var(--fonte-codigo);
    font-size: 1em;
    line-height: 1.75;
    color: #d5dcea;
    overflow: hidden;
  }

  .hv__linha {
    display: flex;
    white-space: pre;
  }

  .hv__num {
    flex: none;
    width: 3.2em;
    padding-right: 1.2em;
    text-align: right;
    color: rgb(255 255 255 / 0.22);
    user-select: none;
  }

  .hv__txt :global(.t-k) {
    color: #7aa2ff;
  }
  .hv__txt :global(.t-s) {
    color: #5fe3ff;
  }
  .hv__txt :global(.t-f) {
    color: #3ea6ff;
  }
  .hv__txt :global(.t-v) {
    color: #ffffff;
  }
  .hv__txt :global(.t-p) {
    color: #b9c4d8;
  }
  .hv__txt :global(.t-b) {
    color: #9ad8ff;
  }
  .hv__txt :global(.t-c) {
    color: #5f6982;
    font-style: italic;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hv__txt {
      clip-path: inset(0 100% 0 0);
      animation: digitar 0.55s steps(22, end) forwards;
      animation-delay: calc(0.9s + var(--l) * 0.2s);
    }

    .hv__linha:last-child .hv__txt::after {
      content: '';
      display: inline-block;
      width: 0.55em;
      height: 1.1em;
      margin-left: 2px;
      vertical-align: -0.18em;
      background: var(--marca-ciano);
      animation: cursor 1s steps(1) infinite;
    }
  }

  @keyframes digitar {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes cursor {
    50% {
      opacity: 0;
    }
  }

  .hv__status {
    display: flex;
    gap: 2.4cqw;
    padding: 1.4cqw 3cqw;
    border-top: 1px solid rgb(255 255 255 / 0.06);
    font-family: var(--fonte-codigo);
    font-size: 0.78em;
    color: var(--texto-3);
  }

  .hv__status-ok {
    display: inline-flex;
    align-items: center;
    gap: 0.8cqw;
    color: #7ee7c0;
  }

  .hv__status-ok i {
    width: 1.2cqw;
    height: 1.2cqw;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }

  /* Celular */
  .hv__celular {
    position: absolute;
    right: 0;
    top: 24%;
    width: 33%;
    aspect-ratio: 9 / 18.6;
    padding: 1.2cqw;
    border-radius: 6cqw;
    background: linear-gradient(160deg, #1b2335, #090c14 60%);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.12),
      0 50px 80px -30px rgb(0 0 0 / 0.9),
      0 30px 80px -30px rgb(1 138 252 / 0.6);
  }

  .hv__tela {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2cqw;
    height: 100%;
    padding: 6.4cqw 2.4cqw 2.4cqw;
    border-radius: 5cqw;
    background:
      radial-gradient(120% 50% at 50% 0%, rgb(1 55 234 / 0.35), transparent 70%),
      #05070d;
    overflow: hidden;
  }

  .hv__ilha {
    position: absolute;
    top: 1.8cqw;
    left: 50%;
    width: 9cqw;
    height: 2.4cqw;
    border-radius: 2cqw;
    background: #000;
    translate: -50% 0;
  }

  .hv__app-topo {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
  }

  .hv__app-topo :global(.hv__app-logo) {
    width: auto;
    height: 3cqw;
  }

  .hv__app-avatar {
    width: 4cqw;
    height: 4cqw;
    margin-left: auto;
    border-radius: 50%;
    background: var(--grad-marca);
  }

  .hv__app-linha {
    display: block;
    height: 1.2cqw;
    width: 100%;
    border-radius: 1cqw;
    background: rgb(255 255 255 / 0.12);
  }

  .hv__app-linha--curta {
    width: 55%;
    background: rgb(255 255 255 / 0.07);
  }

  .hv__app-topo .hv__app-linha--curta {
    width: 9cqw;
  }

  .hv__app-card {
    padding: 2.2cqw;
    border-radius: 3cqw;
    background: linear-gradient(150deg, rgb(5 189 253 / 0.22), rgb(1 55 234 / 0.32));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .hv__app-rotulo {
    display: block;
    font-size: 0.62em;
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }

  .hv__barras {
    display: flex;
    align-items: flex-end;
    gap: 1cqw;
    height: 11cqw;
    margin-top: 1.6cqw;
  }

  .hv__barras span {
    flex: 1;
    height: var(--h);
    border-radius: 0.8cqw 0.8cqw 0.3cqw 0.3cqw;
    background: linear-gradient(to top, rgb(255 255 255 / 0.35), #fff);
    transform-origin: bottom;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hv__barras span {
      animation: crescer 1.1s var(--ease-saida) both;
      animation-delay: calc(1.2s + var(--b) * 0.08s);
    }
  }

  @keyframes crescer {
    from {
      transform: scaleY(0.1);
    }
  }

  .hv__app-lista {
    display: grid;
    gap: 1.6cqw;
  }

  .hv__app-item {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    padding: 1.6cqw;
    border-radius: 2.4cqw;
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
  }

  .hv__app-icone {
    flex: none;
    width: 4.4cqw;
    height: 4.4cqw;
    border-radius: 1.4cqw;
    background: rgb(1 138 252 / 0.35);
  }

  .hv__app-item:nth-child(2) .hv__app-icone {
    background: rgb(5 189 253 / 0.3);
  }

  .hv__app-textos {
    display: grid;
    gap: 1cqw;
    flex: 1;
  }

  .hv__app-nav {
    display: flex;
    justify-content: space-around;
    margin-top: auto;
    padding: 1.8cqw 1cqw 0.6cqw;
    border-top: 1px solid rgb(255 255 255 / 0.06);
  }

  .hv__app-nav span {
    width: 2.4cqw;
    height: 2.4cqw;
    border-radius: 0.8cqw;
    background: rgb(255 255 255 / 0.16);
  }

  .hv__app-nav span.ativo {
    background: var(--marca-ciano);
    box-shadow: 0 0 10px rgb(5 189 253 / 0.7);
  }

  /* Chips flutuantes */
  .hv__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 1.2cqw;
    padding: 1.4cqw 2.4cqw;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: rgb(10 14 24 / 0.86);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.9);
    font-size: 0.95em;
    font-weight: 600;
    color: var(--texto);
    white-space: nowrap;
  }

  .hv__chip :global(.icone) {
    width: 1.25em;
    height: 1.25em;
    color: var(--marca-ciano);
  }

  .hv__chip--1 {
    top: 0;
    right: 13%;
  }
  .hv__chip--2 {
    bottom: 13%;
    left: 4%;
  }
  .hv__chip--3 {
    bottom: 1%;
    right: 30%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hv__celular {
      animation: flutuar 7s ease-in-out infinite;
    }
    .hv__chip--1 {
      animation: flutuar 6s ease-in-out -1s infinite;
    }
    .hv__chip--2 {
      animation: flutuar 8s ease-in-out -3s infinite;
    }
    .hv__chip--3 {
      animation: flutuar 7s ease-in-out -5s infinite;
    }
  }

  @keyframes flutuar {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2.2cqw);
    }
  }

  /* Indicador de rolagem */
  .hero__rolar {
    position: absolute;
    left: 50%;
    bottom: 28px;
    display: none;
    padding: 6px;
    translate: -50% 0;
    border-radius: 999px;
    color: var(--texto-3);
  }

