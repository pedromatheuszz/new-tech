---
import Icone from '../Icone.astro';

const pilares = [
  {
    icone: 'lightbulb',
    titulo: 'Inovação',
    texto: 'Buscamos novas possibilidades e soluções tecnológicas para transformar ideias em projetos digitais.',
  },
  {
    icone: 'gem',
    titulo: 'Qualidade',
    texto: 'Priorizamos funcionalidade, organização, desempenho e atenção aos detalhes em cada projeto.',
  },
  {
    icone: 'handshake',
    titulo: 'Compromisso',
    texto: 'Trabalhamos para compreender as necessidades dos clientes e desenvolver soluções alinhadas aos seus objetivos.',
  },
] as const;

const areas = [
  { icone: 'code-xml', texto: 'Softwares' },
  { icone: 'smartphone', texto: 'Aplicativos' },
  { icone: 'globe', texto: 'Sites profissionais' },
  { icone: 'clapperboard', texto: 'Produção e edição de vídeos' },
] as const;
---

<section id="quem-somos" class="secao sobre" aria-labelledby="sobre-titulo">
  <div class="sobre__luz" aria-hidden="true"></div>
  <div class="container">
    <div class="sobre__grade">
      <div class="sobre__intro">
        <p class="sobrelinha" data-revelar>Quem somos</p>
        <h2 id="sobre-titulo" class="titulo-secao" data-revelar style="--atraso:1">
          Conheça a <span class="texto-gradiente">New Tech</span>
        </h2>
        <p class="sobre__destaque" data-revelar style="--atraso:2">
          A New Tech é uma empresa de tecnologia e inovação dedicada a transformar ideias em soluções digitais eficientes
          e modernas.
        </p>

        <figure class="sobre__codigo card" data-revelar style="--atraso:3">
          <div class="sobre__codigo-barra" aria-hidden="true">
            <span></span><span></span><span></span>
            <span class="sobre__codigo-arquivo">manifesto.ts</span>
          </div>
          <pre aria-hidden="true"><code><span class="c">// o que nos move</span>
<span class="k">const</span> newTech = {'{'}
  une: [
    <span class="s">"tecnologia"</span>,
    <span class="s">"criatividade"</span>,
    <span class="s">"funcionalidade"</span>,
  ],
  para: <span class="s">"gerar valor ao seu negócio"</span>,
{'}'};</code></pre>
          <figcaption class="sr-only">
            Unimos tecnologia, criatividade e funcionalidade para gerar valor ao seu negócio.
          </figcaption>
        </figure>
      </div>

      <div class="sobre__texto">
        <p data-revelar>
          Atuamos no desenvolvimento de <strong>softwares, aplicativos, sites profissionais</strong> e na{' '}
          <strong>produção e edição de vídeos</strong>, oferecendo soluções que ajudam empresas, empreendedores e marcas
          a fortalecer sua presença digital.
        </p>
        <p data-revelar>
          Nossa prioridade é unir tecnologia, criatividade e funcionalidade para desenvolver projetos que atendam às
          necessidades de cada negócio.
        </p>
        <p data-revelar>
          Mais do que criar produtos digitais, buscamos desenvolver soluções que gerem valor, melhorem experiências e
          contribuam para o crescimento dos nossos clientes.
        </p>
        <ul class="sobre__areas" role="list" aria-label="Áreas de atuação" data-revelar>
          {
            areas.map((area) => (
              <li class="selo">
                <Icone nome={area.icone} tamanho={16} />
                {area.texto}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="pilares">
      <p class="pilares__titulo" data-revelar>Nossos pilares</p>
      <ul class="pilares__lista" role="list">
        {
          pilares.map((pilar, i) => (
            <li class="pilar card card--interativo" data-brilho data-revelar style={`--atraso:${i}`}>
              <span class="pilar__numero" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="icone-moldura">
                <Icone nome={pilar.icone} tamanho={24} />
              </span>
              <h3 class="pilar__titulo">{pilar.titulo}</h3>
              <p class="pilar__texto">{pilar.texto}</p>
              <span class="pilar__linha" aria-hidden="true" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .sobre {
    overflow: clip;
  }

  .sobre__luz {
    position: absolute;
    top: 10%;
    left: -20%;
    width: min(760px, 100vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(1 55 234 / 0.16), transparent 65%);
    pointer-events: none;
  }

  .sobre__grade {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .sobre__grade {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .sobre__intro {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .sobre__destaque {
    font-family: var(--fonte-titulo);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--texto);
  }

  .sobre__codigo {
    width: 100%;
    max-width: 460px;
    margin-top: 10px;
    overflow: hidden;
  }

  .sobre__codigo-barra {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--borda);
  }

  .sobre__codigo-barra span:not(.sobre__codigo-arquivo) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }

  .sobre__codigo-arquivo {
    margin-left: 10px;
    font-family: var(--fonte-codigo);
    font-size: 0.75rem;
    color: var(--texto-3);
  }

  .sobre__codigo pre {
    margin: 0;
    padding: 18px 20px 22px;
    font-family: var(--fonte-codigo);
    font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.9rem);
    line-height: 1.75;
    color: #d5dcea;
    overflow-x: auto;
  }

  .sobre__codigo .c {
    color: #5f6982;
    font-style: italic;
  }
  .sobre__codigo .k {
    color: #7aa2ff;
  }
  .sobre__codigo .s {
    color: #5fe3ff;
  }

  .sobre__texto {
    display: grid;
    gap: 22px;
    font-size: clamp(1.0313rem, 1rem + 0.15vw, 1.125rem);
    line-height: 1.8;
    color: var(--texto-2);
  }

  @media (min-width: 1024px) {
    .sobre__texto {
      padding-top: 46px;
    }
  }

  .sobre__texto strong {
    color: var(--texto);
    font-weight: 600;
  }

  .sobre__areas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  /* ---------- Pilares ---------- */
  .pilares {
    margin-top: clamp(64px, 9vw, 112px);
  }

  .pilares__titulo {
    margin-bottom: 24px;
    font-family: var(--fonte-codigo);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-3);
  }

  .pilares__lista {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .pilares__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pilar {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: clamp(26px, 3vw, 34px);
    overflow: hidden;
  }

  .pilar__numero {
    position: absolute;
    top: 18px;
    right: 22px;
    font-family: var(--fonte-titulo);
    font-size: 3.4rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.1);
    transition: -webkit-text-stroke-color 0.4s;
  }

  .pilar:hover .pilar__numero {
    -webkit-text-stroke-color: rgb(5 189 253 / 0.35);
  }

  .pilar__titulo {
    margin-top: 8px;
    font-size: 1.375rem;
  }

  .pilar__texto {
    color: var(--texto-2);
    line-height: 1.7;
  }

  .pilar__linha {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--grad-marca);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-saida);
  }

  .pilar:hover .pilar__linha {
    transform: scaleX(1);
  }
</style>
