---
/** Seção "Projetos": projetos em destaque (src/data/projetos.json). */
import Icone from '../Icone.astro';
import dados from '../../data/projetos.json';

const projetos = dados.projetos;
---

{
  projetos.length > 0 && (
    <section id="projetos" class="secao projetos" aria-labelledby="projetos-titulo">
      <div class="projetos__fundo" aria-hidden="true">
        <div class="projetos__grade-fundo" />
      </div>
      <div class="container">
      <header class="secao-cabecalho secao-cabecalho--centro">
        <p class="sobrelinha" data-revelar>Projetos</p>
        <h2 id="projetos-titulo" class="titulo-secao" data-revelar style="--atraso:1">
          Projetos em <span class="texto-gradiente">destaque</span>
        </h2>
        <p class="subtitulo-secao" data-revelar style="--atraso:2">
          Algumas das soluções que já desenvolvemos. O código está disponível no GitHub.
        </p>
      </header>

      <ul class="projetos__grade" role="list">
        {projetos.map((projeto, i) => (
          <li class="projeto card card--interativo" data-brilho data-revelar style={`--atraso:${i % 2}`}>
            <div class="projeto__topo">
              <span class="icone-moldura">
                <Icone nome={projeto.icone} tamanho={22} />
              </span>
              <span class:list={['projeto__tipo', { 'projeto__tipo--pessoal': projeto.tipo === 'Projeto pessoal' }]}>
                {projeto.tipo}
              </span>
            </div>
            <p class="projeto__categoria">{projeto.categoria}</p>
            <h3 class="projeto__nome">{projeto.nome}</h3>
            <p class="projeto__descricao">{projeto.descricao}</p>
            <ul class="projeto__tecnologias" role="list" aria-label={`Tecnologias de ${projeto.nome}`}>
              {projeto.tecnologias.map((tecnologia) => (
                <li>{tecnologia}</li>
              ))}
            </ul>
            <div class="projeto__links">
              <a href={projeto.github} target="_blank" rel="noopener noreferrer">
                <Icone nome="marca-github" tamanho={16} />
                Código no GitHub
                <span class="sr-only">: {projeto.nome} (abre em nova aba)</span>
              </a>
              {projeto.site && (
                <a href={projeto.site} target="_blank" rel="noopener noreferrer">
                  <Icone nome="arrow-up-right" tamanho={16} />
                  Ver site
                  <span class="sr-only">: {projeto.nome} (abre em nova aba)</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>

      {dados.perfilGithub && (
        <p class="projetos__perfil" data-revelar>
          <a class="btn btn-secundario" href={dados.perfilGithub} target="_blank" rel="noopener noreferrer">
            <Icone nome="marca-github" tamanho={18} />
            Ver todos no GitHub
            <span class="sr-only">(abre em nova aba)</span>
          </a>
        </p>
      )}
      </div>
    </section>
  )
}

<style>
  .projetos {
    overflow: clip;
  }

  .projetos__fundo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 55% at 50% 45%, rgb(1 55 234 / 0.26), transparent 70%),
      radial-gradient(40% 40% at 80% 15%, rgb(5 189 253 / 0.1), transparent 70%);
  }

  .projetos__grade-fundo {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, #000 30%, transparent 80%);
  }

  .projetos__grade {
    position: relative;
    display: grid;
    gap: 20px;
  }

  .projetos__perfil {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }

  @media (min-width: 860px) {
    .projetos__grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .projeto {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(24px, 3vw, 32px);
    background: linear-gradient(180deg, rgb(10 14 26 / 0.85), rgb(6 8 15 / 0.85));
  }

  .projeto__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .projeto__tipo {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgb(5 189 253 / 0.35);
    background: rgb(1 138 252 / 0.1);
    color: #d6ebff;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .projeto__tipo--pessoal {
    border-color: var(--borda-forte);
    background: rgb(255 255 255 / 0.04);
    color: var(--texto-2);
  }

  .projeto__categoria {
    font-family: var(--fonte-codigo);
    font-size: 0.8125rem;
    color: var(--marca-ciano);
  }

  .projeto__nome {
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.6rem);
    letter-spacing: -0.02em;
  }

  .projeto__descricao {
    color: var(--texto-2);
    line-height: 1.7;
  }

  .projeto__tecnologias {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .projeto__tecnologias li {
    padding: 4px 10px;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.05);
    font-family: var(--fonte-codigo);
    font-size: 0.75rem;
    color: var(--texto-2);
  }

  .projeto__links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--borda);
  }

  .projeto__links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--link);
    transition: color 0.2s;
  }

  .projeto__links a:hover {
    color: var(--marca-ciano);
  }

  .projetos__perfil :global(.icone) {
    color: var(--texto);
  }
</style>
