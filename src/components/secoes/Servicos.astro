---
import Icone from '../Icone.astro';
import servicosDados from '../../data/servicos.json';

type Servico = (typeof servicosDados.servicos)[number] & {
  selo?: string;
  diferenciais?: { icone: string; texto: string }[];
  diferenciaisTitulo?: string;
  nota?: string;
};

const servicos = servicosDados.servicos as Servico[];

/** Etapas ilustradas no card de destaque (software e aplicativos). */
const fluxo = [
  { icone: 'lightbulb', texto: 'Ideia' },
  { icone: 'code-xml', texto: 'Desenvolvimento' },
  { icone: 'rocket', texto: 'Solução no ar' },
] as const;
---

<section id="servicos" class="secao servicos" aria-labelledby="servicos-titulo">
  <div class="servicos__fundo" aria-hidden="true"></div>
  <div class="container">
    <header class="secao-cabecalho secao-cabecalho--centro">
      <p class="sobrelinha" data-revelar>Como podemos ajudar seu negócio</p>
      <h2 id="servicos-titulo" class="titulo-secao" data-revelar style="--atraso:1">
        Soluções digitais para levar seu negócio <span class="texto-gradiente">mais longe.</span>
      </h2>
      <p class="subtitulo-secao" data-revelar style="--atraso:2">
        Da programação à criatividade, desenvolvemos soluções que ajudam sua empresa a crescer e se destacar no ambiente
        digital.
      </p>
    </header>

    <div class="servicos__grade">
      {
        servicos.map((servico, i) => (
          <article
            id={`servico-${servico.id}`}
            class:list={['servico card', { 'servico--destaque': servico.destaque }]}
            aria-labelledby={`servico-${servico.id}-titulo`}
            data-brilho
            data-revelar
            style={`--atraso:${servico.destaque ? 0 : i - 1}`}
          >
            <div class="servico__principal">
              <div class="servico__topo">
                <span class="icone-moldura servico__icone">
                  <Icone nome={servico.icone} tamanho={servico.destaque ? 28 : 24} />
                </span>
                <span class="servico__numero" aria-hidden="true">
                  {servico.numero}
                </span>
                {servico.selo && (
                  <span class="selo servico__selo">
                    <Icone nome="sparkles" tamanho={14} />
                    {servico.selo}
                  </span>
                )}
              </div>
              <p class="servico__categoria">{servico.categoria}</p>
              <h3 id={`servico-${servico.id}-titulo`} class="servico__titulo">
                {servico.titulo}
              </h3>
              <p class="servico__descricao">{servico.descricao}</p>

              {servico.destaque && (
                <ol class="servico__fluxo" role="list" aria-label="Da ideia à solução">
                  {fluxo.map((etapa, j) => (
                    <li style={`--j:${j}`}>
                      <span class="servico__fluxo-icone">
                        <Icone nome={etapa.icone} tamanho={18} />
                      </span>
                      <span class="servico__fluxo-texto">{etapa.texto}</span>
                    </li>
                  ))}
                </ol>
              )}
            </div>

            <div class="servico__detalhes">
              <p class="servico__rotulo">Possíveis soluções</p>
              <ul class="lista-check" role="list">
                {servico.solucoes.map((solucao) => (
                  <li>
                    <Icone nome="check" tamanho={16} espessura={2.5} />
                    {solucao}
                  </li>
                ))}
              </ul>

              {servico.diferenciais && (
                <div class="servico__diferenciais">
                  <p class="servico__rotulo">{servico.diferenciaisTitulo}</p>
                  <ul role="list">
                    {servico.diferenciais.map((item) => (
                      <li class="selo">
                        <Icone nome={item.icone} tamanho={15} />
                        {item.texto}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {servico.nota && (
                <p class="servico__nota">
                  <Icone nome="circle-play" tamanho={20} />
                  <span>{servico.nota}</span>
                </p>
              )}
            </div>

            <div class="servico__acao">
              <a
                href="#contato"
                class:list={['btn', servico.destaque ? 'btn-primario' : 'btn-secundario']}
                data-servico={servico.formulario}
              >
                Tenho interesse
                <span class="sr-only"> em {servico.titulo}</span>
                <Icone nome="arrow-right" tamanho={18} class="icone--seta" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .servicos {
    background: linear-gradient(180deg, transparent, rgb(7 10 18 / 0.9) 18%, rgb(7 10 18 / 0.9) 82%, transparent);
    overflow: clip;
  }

  .servicos__fundo {
    position: absolute;
    top: 18%;
    left: 50%;
    width: min(1100px, 140vw);
    aspect-ratio: 1.6;
    translate: -50% 0;
    background: radial-gradient(closest-side, rgb(1 55 234 / 0.22), transparent);
    pointer-events: none;
  }

  .servicos__grade {
    display: grid;
    gap: 22px;
  }

  @media (min-width: 1024px) {
    .servicos__grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Card ---------- */
  .servico {
    display: grid;
    grid-template-areas:
      'principal'
      'detalhes'
      'acao';
    grid-template-rows: auto 1fr auto;
    gap: 28px;
    padding: clamp(26px, 3.4vw, 40px);
    overflow: hidden;
  }

  .servico:hover {
    border-color: rgb(5 189 253 / 0.3);
  }

  .servico__principal {
    grid-area: principal;
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .servico__detalhes {
    grid-area: detalhes;
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .servico__acao {
    grid-area: acao;
  }

  .servico__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 8px;
  }

  .servico__numero {
    font-family: var(--fonte-codigo);
    font-size: 0.875rem;
    color: var(--texto-3);
  }

  .servico__selo {
    margin-left: auto;
    border-color: rgb(5 189 253 / 0.35);
    background: rgb(1 138 252 / 0.1);
    color: #d6ebff;
  }

  .servico__categoria {
    font-family: var(--fonte-codigo);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    color: var(--marca-ciano);
  }

  .servico__titulo {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
    letter-spacing: -0.025em;
  }

  .servico__descricao {
    color: var(--texto-2);
    line-height: 1.7;
  }

  .servico__rotulo {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-3);
  }

  .servico__diferenciais {
    display: grid;
    gap: 12px;
    margin-top: 6px;
    padding-top: 20px;
    border-top: 1px solid var(--borda);
  }

  .servico__diferenciais ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .servico__nota {
    display: flex;
    gap: 12px;
    margin-top: 6px;
    padding: 16px 18px;
    border-radius: var(--raio);
    border: 1px solid rgb(5 189 253 / 0.2);
    background: linear-gradient(135deg, rgb(1 138 252 / 0.1), rgb(1 55 234 / 0.04));
    color: #d6e4f7;
    line-height: 1.6;
  }

  .servico__nota :global(.icone) {
    flex: none;
    margin-top: 2px;
    color: var(--marca-ciano);
  }

  .servico__acao :global(.btn) {
    width: 100%;
  }

  @media (min-width: 480px) {
    .servico__acao :global(.btn) {
      width: auto;
    }
  }

  /* ---------- Card de destaque (software e aplicativos) ---------- */
  .servico--destaque {
    border-color: transparent;
    background:
      linear-gradient(180deg, #0b1120, #070a12) padding-box,
      var(--grad-borda) border-box;
    box-shadow:
      0 40px 100px -50px rgb(1 138 252 / 0.6),
      var(--sombra-card);
  }

  .servico--destaque::after {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(1 55 234 / 0.3), transparent 65%);
    pointer-events: none;
  }

  .servico--destaque .icone-moldura {
    width: 60px;
    height: 60px;
    border-radius: 16px;
  }

  .servico--destaque .servico__titulo {
    font-size: clamp(1.6rem, 1.25rem + 1.4vw, 2.25rem);
  }

  .servico--destaque .servico__descricao {
    font-size: 1.0625rem;
    max-width: 520px;
  }

  @media (min-width: 1024px) {
    .servico--destaque {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      grid-template-areas:
        'principal detalhes'
        'acao detalhes';
      column-gap: clamp(40px, 5vw, 72px);
    }

    .servico--destaque .servico__detalhes {
      align-self: stretch;
      align-content: center;
      padding: 32px;
      border-radius: var(--raio-lg);
      border: 1px solid var(--borda);
      background: rgb(255 255 255 / 0.025);
    }

    .servico--destaque .lista-check {
      gap: 16px;
    }
  }

  @media (min-width: 640px) and (max-width: 1023.98px) {
    .servico--destaque .lista-check,
    .servico:not(.servico--destaque) .lista-check {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
    }
  }

  /* Fluxo ideia → solução */
  .servico__fluxo {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    max-width: 460px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }

  .servico__fluxo::before {
    content: '';
    position: absolute;
    top: 21px;
    left: 22px;
    right: 22px;
    height: 2px;
    background: repeating-linear-gradient(90deg, rgb(5 189 253 / 0.6) 0 8px, transparent 8px 14px);
    background-size: 28px 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .servico__fluxo::before {
      animation: fluxo 1.2s linear infinite;
    }
  }

  @keyframes fluxo {
    to {
      background-position: 28px 0;
    }
  }

  .servico__fluxo li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }

  .servico__fluxo-icone {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(5 189 253 / 0.4);
    background: #0a1222;
    color: var(--marca-ciano);
    box-shadow: 0 0 22px -4px rgb(1 138 252 / 0.7);
  }

  .servico__fluxo li:last-child .servico__fluxo-icone {
    color: #fff;
    border-color: transparent;
    background: var(--grad-botao);
  }

  .servico__fluxo-texto {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--texto-2);
  }
</style>
