---
import Icone from '../Icone.astro';import dados from '../../data/resultados.json';

interface Indicador {
  id: string;
  rotulo: string;
  descricao?: string;
  valor: number | null;
  prefixo?: string;
  sufixo?: string;
  casasDecimais?: number;
  icone: string;
}

const indicadores = (dados.indicadores as Indicador[]).map((item) => {
  const definido = typeof item.valor === 'number' && Number.isFinite(item.valor);
  const casas = item.casasDecimais ?? 0;
  const numero = definido
    ? new Intl.NumberFormat('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas }).format(item.valor!)
    : '';
  return { ...item, definido, casas, texto: definido ? `${item.prefixo ?? ''}${numero}${item.sufixo ?? ''}` : '' };
});
---

<section id="resultados" class="secao resultados" aria-labelledby="resultados-titulo">
  <div class="resultados__fundo" aria-hidden="true">
    <div class="resultados__grade"></div>
  </div>
  <div class="container">
    <header class="secao-cabecalho secao-cabecalho--centro">
      <p class="sobrelinha" data-revelar>Resultados</p>
      <h2 id="resultados-titulo" class="titulo-secao" data-revelar style="--atraso:1">
        Resultados que representam <span class="texto-gradiente">nossa evolução</span>
      </h2>
      <p class="subtitulo-secao" data-revelar style="--atraso:2">
        Cada projeto representa uma oportunidade de criar, inovar e desenvolver soluções digitais.
      </p>
    </header>

    <dl class="resultados__lista">
      {
        indicadores.map((item, i) => (
          <div class="indicador card" data-brilho data-revelar style={`--atraso:${i}`}>
            <dt class="indicador__rotulo">{item.rotulo}</dt>
            <dd class="indicador__valor">
              <span class="indicador__icone" aria-hidden="true">
                <Icone nome={item.icone} tamanho={20} />
              </span>
              {item.definido ? (
                <span
                  class="indicador__numero"
                  data-contador
                  data-alvo={item.valor}
                  data-prefixo={item.prefixo ?? ''}
                  data-sufixo={item.sufixo ?? ''}
                  data-casas={item.casas}
                >
                  {item.texto}
                </span>
              ) : (
                <span class="indicador__pendente">
                  <span aria-hidden="true">—</span>
                  <span class="sr-only">Valor a definir</span>
                </span>
              )}
            </dd>
            {item.descricao && <dd class="indicador__descricao">{item.descricao}</dd>}
            {!item.definido && (
              <dd class="indicador__aviso">
                <Icone nome="clock" tamanho={13} /> Valor a definir
              </dd>
            )}
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  import '../../scripts/contadores';
</script>

<style>
  .resultados {
    overflow: clip;
  }

  .resultados__fundo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 55% at 50% 55%, rgb(1 55 234 / 0.3), transparent 70%),
      radial-gradient(40% 40% at 80% 20%, rgb(5 189 253 / 0.1), transparent 70%);
  }

  .resultados__grade {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 55%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 55%, #000 30%, transparent 80%);
  }

  .resultados__lista {
    position: relative;
    display: grid;
    gap: 18px;
  }

  @media (min-width: 600px) {
    .resultados__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .resultados__lista {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .indicador {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(24px, 2.6vw, 32px);
    background: linear-gradient(180deg, rgb(10 14 26 / 0.85), rgb(6 8 15 / 0.85));
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .indicador__icone {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 22px;
    border-radius: 12px;
    color: var(--marca-ciano);
    background: rgb(1 138 252 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(5 189 253 / 0.25);
  }

  /* O número aparece acima do rótulo, mantendo a ordem semântica rótulo → valor */
  .indicador__valor {
    order: -1;
    margin: 0;
  }

  .indicador__numero,
  .indicador__pendente {
    display: block;
    font-family: var(--fonte-titulo);
    font-size: clamp(2.75rem, 2rem + 2.6vw, 3.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .indicador__numero {
    background: var(--grad-texto);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .indicador__pendente {
    color: rgb(255 255 255 / 0.22);
  }

  .indicador__rotulo {
    font-family: var(--fonte-titulo);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--texto);
  }

  .indicador__descricao {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--texto-2);
  }

  .indicador__aviso {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    margin: 6px 0 0;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px dashed rgb(255 255 255 / 0.18);
    font-family: var(--fonte-codigo);
    font-size: 0.75rem;
    color: var(--texto-3);
  }
</style>
