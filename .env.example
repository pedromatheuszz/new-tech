# ─────────────────────────────────────────────────────────────────────────────
# Formulário de contato — copie este arquivo para ".env" (desenvolvimento) ou
# cadastre as variáveis no painel da hospedagem (Vercel → Settings → Environment Variables).
# Configure pelo menos UM canal de entrega: SMTP (e-mail) e/ou webhook.
# Sem nenhum canal, em produção o formulário responde com erro (não finge sucesso).
# Em desenvolvimento (npm run dev), sem canal configurado, as mensagens são gravadas
# em .data/contatos.ndjson para testes.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública do site (opcional se já estiver em src/data/site.json ou se usar a Vercel)
# SITE_URL=https://www.seudominio.com.br

# ── E-mail via SMTP (Gmail com senha de app, Zoho, Hostinger, Locaweb, Brevo, Resend etc.)
SMTP_HOST=
# 587 (STARTTLS) ou 465 (SSL). Padrão: 587
SMTP_PORT=587
# "true" para porta 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Quem recebe as mensagens (pode ser mais de um, separados por vírgula). Padrão: SMTP_USER
CONTATO_DESTINATARIO=
# Remetente exibido no e-mail. Padrão: SMTP_USER. Ex.: "Site New Tech <contato@seudominio.com.br>"
CONTATO_REMETENTE=

# ── Webhook (opcional): recebe um POST em JSON a cada mensagem (n8n, Make, Zapier, Google Apps Script...)
CONTATO_WEBHOOK_URL=
# Enviado no cabeçalho "Authorization: Bearer <token>" (opcional)
CONTATO_WEBHOOK_TOKEN=

# Domínios extras autorizados a enviar o formulário, separados por vírgula (opcional)
# Ex.: https://newtech.com.br,https://www.newtech.com.br
CONTATO_ORIGENS_PERMITIDAS=
